# pdf2md service configuration
# Copy to .env and adjust values as needed

# Database (used by api + worker containers)
PDF2MD_SERVICE_DATABASE_URL=postgresql+asyncpg://pdf2md:pdf2md@postgres:5432/pdf2md

# Redis (used by api + worker containers)
PDF2MD_SERVICE_REDIS_URL=redis://redis:6379

# Data storage paths (inside containers)
PDF2MD_SERVICE_DATA_DIR=/data
PDF2MD_SERVICE_UPLOAD_DIR=/data/uploads

# Auth settings
PDF2MD_SERVICE_AUTH_TIMESTAMP_TOLERANCE_SECONDS=300

# Worker settings
PDF2MD_SERVICE_WORKER_MAX_JOBS=1

# Docling extraction defaults
PDF2MD_SERVICE_IMAGES_SCALE=2.0
PDF2MD_SERVICE_MIN_IMAGE_WIDTH=200
PDF2MD_SERVICE_MIN_IMAGE_HEIGHT=150
PDF2MD_SERVICE_MIN_IMAGE_AREA=40000
